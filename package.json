{
  "name": "spendwise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3737",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3737",
    "demo": "SPENDWISE_HOME=.demo next dev -H 127.0.0.1 -p 3738",
    "demo:seed": "SPENDWISE_HOME=.demo tsx scripts/import.ts tests/fixtures/*",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "import": "tsx scripts/import.ts",
    "watch": "tsx scripts/watcher.ts",
    "backup": "tsx scripts/backup.ts",
    "install-agent": "tsx scripts/install-agent.ts",
    "uninstall-agent": "tsx scripts/install-agent.ts --uninstall"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chokidar": "^6.0.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
